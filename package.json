{
  "name": "pivot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter @pivot/core test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "db:generate": "pnpm --filter @pivot/core db:generate",
    "setup:browser": "pnpm --filter @pivot/core exec playwright install chromium",
    "ext:build": "pnpm --filter extension build",
    "ext:dev": "pnpm --filter extension dev",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
