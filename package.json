{
  "name": "pivot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PTan2505/pivot.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter @pivot/core --filter @pivot/mcp-tools --filter extension --filter pivot-studio test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "db:generate": "pnpm --filter @pivot/core db:generate",
    "setup:browser": "pnpm --filter @pivot/core exec playwright install chromium",
    "ext:build": "pnpm --filter extension build",
    "ext:dev": "pnpm --filter extension dev",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "mcp:build": "pnpm --filter @pivot/mcp build",
    "cli:build": "pnpm --filter pivot-studio build",
    "builder:build": "node packages/core/scripts/build-builder.mjs",
    "builder:setup": "node scripts/builder-setup.mjs",
    "owner:passphrase": "node scripts/owner-passphrase.mjs",
    "plugin:validate": "claude plugin validate ./plugin --strict && claude plugin validate . --strict"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
