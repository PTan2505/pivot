# Where PIVOT keeps its database (PGlite mode), assets and exports.
# PIVOT_DATA_DIR=~/.pivot

# Leave unset to use the embedded local Postgres (PGlite, offline).
# Set to a Neon connection string to store metadata in the cloud instead.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 for files (screenshots, uploads). Leave unset to keep files in PIVOT_DATA_DIR.
# Create an R2 API token with "Object Read & Write" on the bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pivot
# R2_ENDPOINT=   (only for EU-jurisdiction buckets: https://<account>.eu.r2.cloudflarestorage.com)

# Global Claude Code skills directory.
# CLAUDE_SKILLS_DIR=~/.claude/skills

# Port for `npm start` / `npm run dev`.
# PORT=4321
