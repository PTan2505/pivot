# Where Stan Bag keeps its database (PGlite mode), assets and exports.
# STAN_BAG_DATA_DIR=~/.stan-bag

# Leave unset to use the embedded local Postgres (PGlite, offline).
# Set to a Neon connection string to store metadata in the cloud instead.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Global Claude Code skills directory.
# CLAUDE_SKILLS_DIR=~/.claude/skills

# Port for `npm start` / `npm run dev`.
# PORT=4321
